{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webforms.docyrus.app/schemas/webform-builder.schema.json",
  "title": "Docyrus Webforms persisted builder schema",
  "description": "The canonical `schema` JSON emitted by schemaFromBuilderState(). This contract covers the field children generated by the project-owned Webforms builder.",
  "type": "object",
  "required": [
    "version",
    "children"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldChild"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "paletteFieldType": {
      "description": "The 30 field types that can be added from the native Webforms builder palette.",
      "type": "string",
      "enum": [
        "field-text",
        "field-textarea",
        "field-email",
        "field-url",
        "field-phone",
        "field-number",
        "field-money",
        "field-percent",
        "field-rating",
        "field-linearScale",
        "field-duration",
        "field-currency",
        "field-select",
        "field-tagSelect",
        "field-radioGroup",
        "field-choiceGrid",
        "field-checkboxGrid",
        "field-section",
        "field-date",
        "field-dateTime",
        "field-time",
        "field-dateRange",
        "field-switch",
        "field-checkbox",
        "field-file",
        "field-image",
        "field-userSelect",
        "field-userMultiSelect",
        "field-relation",
        "field-locationSelect"
      ]
    },
    "builderFieldType": {
      "description": "Normally one of paletteFieldType. Kept extensible because imported children with a field slug and another Docyrus field type are loaded and can round-trip.",
      "type": "string",
      "minLength": 1
    },
    "fieldChild": {
      "type": "object",
      "required": [
        "type",
        "field",
        "layout"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/builderFieldType"
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "enumOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enumOption"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "colSpan",
        "rowSpan"
      ],
      "properties": {
        "colSpan": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "rowSpan": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "stepId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "gridRow": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fieldOptions": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "horizontal": {
          "type": "boolean"
        },
        "scaleMin": {
          "type": "number"
        },
        "scaleMax": {
          "type": "number"
        },
        "minLabel": {
          "type": "string"
        },
        "maxLabel": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridRow"
          }
        },
        "internal": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "enumOption": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "sort_order": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "is_final_option": {
          "type": "boolean"
        },
        "force_description": {
          "type": "boolean"
        },
        "force_followup_date": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mapping": {
      "type": "object",
      "properties": {
        "iconField": {
          "type": [
            "string",
            "null"
          ]
        },
        "colorField": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageField": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptionField": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "queryBuilderCondition": {
      "type": "object",
      "required": [
        "combinator",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "combinator": {
          "type": "string"
        },
        "rules": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "computedCondition": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/queryBuilderCondition"
        },
        {
          "type": "null"
        }
      ]
    },
    "customValidation": {
      "type": "object",
      "required": [
        "id",
        "expression",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "setFieldValueStep": {
      "type": "object",
      "required": [
        "method",
        "fieldSlug",
        "value"
      ],
      "properties": {
        "method": {
          "const": "setFieldValue"
        },
        "fieldSlug": {
          "type": "string"
        },
        "value": true
      },
      "additionalProperties": false
    },
    "setFieldValuesStep": {
      "type": "object",
      "required": [
        "method",
        "fields"
      ],
      "properties": {
        "method": {
          "const": "setFieldValues"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fieldSlug",
              "value"
            ],
            "properties": {
              "fieldSlug": {
                "type": "string"
              },
              "value": true
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fieldSlugStep": {
      "type": "object",
      "required": [
        "method",
        "fieldSlug"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "clearFieldValue",
            "showField",
            "hideField"
          ]
        },
        "fieldSlug": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "setFieldRequiredStep": {
      "type": "object",
      "required": [
        "method",
        "fieldSlug",
        "required"
      ],
      "properties": {
        "method": {
          "const": "setFieldRequired"
        },
        "fieldSlug": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "setFieldDisabledStep": {
      "type": "object",
      "required": [
        "method",
        "fieldSlug",
        "disabled"
      ],
      "properties": {
        "method": {
          "const": "setFieldDisabled"
        },
        "fieldSlug": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "setFieldReadOnlyStep": {
      "type": "object",
      "required": [
        "method",
        "fieldSlug",
        "readOnly"
      ],
      "properties": {
        "method": {
          "const": "setFieldReadOnly"
        },
        "fieldSlug": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fieldActionStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/setFieldValueStep"
        },
        {
          "$ref": "#/$defs/setFieldValuesStep"
        },
        {
          "$ref": "#/$defs/fieldSlugStep"
        },
        {
          "$ref": "#/$defs/setFieldRequiredStep"
        },
        {
          "$ref": "#/$defs/setFieldDisabledStep"
        },
        {
          "$ref": "#/$defs/setFieldReadOnlyStep"
        }
      ]
    },
    "fieldActionBlockItem": {
      "type": "object",
      "required": [
        "id",
        "condition",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/computedCondition"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldActionStep"
          }
        }
      },
      "additionalProperties": false
    },
    "fieldActionBlock": {
      "type": "object",
      "required": [
        "id",
        "sortOrder",
        "conditionalItems",
        "elseActions",
        "unconditionalActions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sortOrder": {
          "type": "number"
        },
        "conditionalItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldActionBlockItem"
          }
        },
        "elseActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldActionStep"
          }
        },
        "unconditionalActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldActionStep"
          }
        }
      },
      "additionalProperties": false
    },
    "fieldAction": {
      "type": "object",
      "required": [
        "id",
        "triggerType",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "triggerType": {
          "const": "onFieldChange"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldActionBlock"
          }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/builderFieldType"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "validations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "readOnly": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "options": {
          "oneOf": [
            {
              "$ref": "#/$defs/fieldOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "enums": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/enumOption"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "maxRating": {
          "type": [
            "number",
            "null"
          ]
        },
        "relationDataSourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatarMapping": {
          "oneOf": [
            {
              "$ref": "#/$defs/mapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "nested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nestedByProp": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemMapping": {
          "oneOf": [
            {
              "$ref": "#/$defs/mapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "computedHidden": {
          "$ref": "#/$defs/computedCondition"
        },
        "computedRequired": {
          "$ref": "#/$defs/computedCondition"
        },
        "computedLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "computedDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "computedFormula": {
          "type": [
            "string",
            "null"
          ]
        },
        "fieldActions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/fieldAction"
          }
        },
        "customValidations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/customValidation"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
