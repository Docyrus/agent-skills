{
  "$schema": "../schemas/webform-design-output.schema.json",
  "schema": {
    "version": 1,
    "children": [
      {
        "type": "field-section",
        "field": {
          "id": "field-section-contact",
          "name": "Contact details",
          "slug": "contact_details_section",
          "type": "field-section",
          "options": {
            "description": "Tell us how we can reach you."
          }
        },
        "layout": {
          "colSpan": 2,
          "rowSpan": 1,
          "stepId": "step-contact"
        }
      },
      {
        "type": "field-text",
        "field": {
          "id": "field-text-name",
          "name": "Full name",
          "slug": "full_name",
          "type": "field-text",
          "validations": [
            "required",
            "minLength:2",
            "maxLength:100"
          ],
          "options": {
            "placeholder": "Ada Lovelace",
            "description": "Enter your legal name."
          }
        },
        "layout": {
          "colSpan": 1,
          "rowSpan": 1,
          "stepId": "step-contact"
        }
      },
      {
        "type": "field-textarea",
        "field": {
          "id": "field-textarea-notes",
          "name": "Notes",
          "slug": "notes",
          "type": "field-textarea",
          "validations": [
            "maxLength:1000"
          ],
          "options": {
            "placeholder": "Add any relevant context..."
          }
        },
        "layout": {
          "colSpan": 2,
          "rowSpan": 2,
          "stepId": "step-contact"
        }
      },
      {
        "type": "field-email",
        "field": {
          "id": "field-email-email",
          "name": "Email",
          "slug": "email",
          "type": "field-email",
          "validations": [
            "required"
          ],
          "options": {
            "placeholder": "ada@example.com"
          }
        },
        "layout": {
          "colSpan": 1,
          "rowSpan": 1,
          "stepId": "step-contact"
        }
      },
      {
        "type": "field-url",
        "field": {
          "id": "field-url-website",
          "name": "Website",
          "slug": "website",
          "type": "field-url",
          "options": {
            "placeholder": "https://example.com"
          }
        },
        "layout": {
          "colSpan": 1,
          "rowSpan": 1,
          "stepId": "step-contact"
        }
      },
      {
        "type": "field-phone",
        "field": {
          "id": "field-phone-mobile",
          "name": "Mobile phone",
          "slug": "mobile_phone",
          "type": "field-phone",
          "validations": [
            "required"
          ]
