    "classicGrid": {
      "title": "Customer discovery",
      "description": "Tell us about your needs and experience.",
      "gridColumns": 2,
      "stepMode": "wizard",
      "showStepProgress": true,
      "submitLabel": "Send response",
      "successMessage": "Your response has been received.",
      "steps": [
        {
          "id": "step-contact",
          "title": "Contact",
          "description": "Your contact information"
        },
        {
          "id": "step-details",
          "title": "Details",
          "description": "Request and scheduling details"
        },
        {
          "id": "step-feedback",
          "title": "Feedback",
          "description": "Final questions and attachments"
        }
      ]
    },
    "conversationalFlow": {
      "welcomeTitle": "Welcome",
      "welcomeDescription": "Let’s go through each question one at a time.",
      "progressStyle": "bar",
      "autoAdvance": false,
      "submitLabel": "Send response",
      "successMessage": "Your response has been received."
    }
